}

int existeHorario(FILE *fichero,
                  char centroBuscado[],
                  char actividadBuscada[],
                  char diaBuscado[],
                  char horarioBuscado[]) {
    Actividad a;
    char cabecera[1000];
    int encontrado = 0;

    rewind(fichero);
    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a) && encontrado == 0) {
        if (strcmp(a.centro, centroBuscado) == 0 &&
            strcmp(a.actividad_base, actividadBuscada) == 0 &&
            strcmp(a.dia_semana, diaBuscado) == 0 &&
            strcmp(a.hora_inicio, horarioBuscado) == 0) {
            encontrado = 1;
        }
    }

    return encontrado;
}

void reservarPlaza(FILE *fichero) {
    char centroBuscado[N];
    char actividadBuscada[N];
    char diaBuscado[N];
    char horarioBuscado[N];

    Actividad a;
    char cabecera[1000];

    int reservaHecha = 0;

    do {
        printf("Nombre del centro: ");
        scanf("%s", centroBuscado);

        if (existeCentro(fichero, centroBuscado) == 0) {
            printf("Ese centro no existe. Intentalo otra vez.\n");
        }

    } while (existeCentro(fichero, centroBuscado) == 0);

    do {
        printf("Actividad que quieres realizar: ");
        scanf("%s", actividadBuscada);

        if (existeActividadEnCentro(fichero, centroBuscado, actividadBuscada) == 0) {
            printf("Esa actividad no existe en ese centro.\n");
        }

    } while (existeActividadEnCentro(fichero, centroBuscado, actividadBuscada) == 0);

    do {
        printf("Dia de la semana: ");
        scanf("%s", diaBuscado);

        rewind(fichero);
        fgets(cabecera, 1000, fichero);

        reservaHecha = 0;

        while (leerActividad(fichero, &a) && reservaHecha == 0) {
            if (strcmp(a.centro, centroBuscado) == 0 &&
                strcmp(a.actividad_base, actividadBuscada) == 0 &&
                strcmp(a.dia_semana, diaBuscado) == 0) {
                reservaHecha = 1;
            }
        }

        if (reservaHecha == 0) {
            printf("Ese dia no existe para esa actividad.\n");
        }

    } while (reservaHecha == 0);

    do {
        printf("Horario de inicio: ");
        scanf("%s", horarioBuscado);

        if (existeHorario(fichero,
                          centroBuscado,
                          actividadBuscada,
                          diaBuscado,
                          horarioBuscado) == 0) {
            printf("Ese horario no existe.\n");
        }

    } while (existeHorario(fichero,
                           centroBuscado,
                           actividadBuscada,
                           diaBuscado,
                           horarioBuscado) == 0);

    rewind(fichero);
    fgets(cabecera, 1000, fichero);

    reservaHecha = 0;

    while (leerActividad(fichero, &a) && reservaHecha == 0) {
        if (strcmp(a.centro, centroBuscado) == 0 &&
            strcmp(a.actividad_base, actividadBuscada) == 0 &&
            strcmp(a.dia_semana, diaBuscado) == 0 &&
            strcmp(a.hora_inicio, horarioBuscado) == 0) {

            if (a.libres > 0) {
                printf("\nPlaza reservada correctamente.\n");
                printf("Centro: %s\n", a.centro);
                printf("Actividad: %s\n", a.actividad_base);
                printf("Dia: %s\n", a.dia_semana);
                printf("Horario: %s\n", a.hora_inicio);
                printf("Plazas libres: %d\n", a.libres);
            } else {
                printf("\nNo hay plazas disponibles.\n");
            }

            reservaHecha = 1;
        }
    }
}

int existeActividad(Listado *listado, int nListado, char centro[], char actividad[]) {
    int i;

    for (i = 0; i < nListado; i++) {
        if (strcmp(listado[i].centro, centro) == 0 &&
            strcmp(listado[i].actividad, actividad) == 0) {
            return 1;
        }
    }

    return 0;
}

void listadoActividadesPorCentro() {
    FILE *f;
    Actividad *datos;
    Listado *listado;
    int n = 0;
    int nListado = 0;
    int i;
    char cabecera[300];

    datos = (Actividad *) malloc(MAX_DATOS * sizeof(Actividad));

    if (datos == NULL) {
        printf("Error de memoria\n");
        return;
    }

    f = fopen("dataset.csv", "r");

    if (f == NULL) {
        printf("Error al abrir dataset.csv\n");
        free(datos);
        return;
    }

    fgets(cabecera, 300, f);

    while (n < MAX_DATOS &&
           fscanf(f, "%d %d %d %s %s %s %s %s %s %d %d %d %s",
                  &datos[n].anio,
                  &datos[n].mes,
                  &datos[n].dia,
                  datos[n].dia_semana,
                  datos[n].hora_inicio,
                  datos[n].hora_fin,
                  datos[n].actividad_base,
                  datos[n].modalidad,
                  datos[n].centro,
                  &datos[n].plazas,
                  &datos[n].ocupadas,
                  &datos[n].libres,
                  datos[n].tipo_actividad) == 13) {
        n++;
    }

    fclose(f);

    listado = (Listado *) malloc(n * sizeof(Listado));

    if (listado == NULL) {
        printf("Error de memoria\n");
        free(datos);
        return;
    }

    for (i = 0; i < n; i++) {
        if (existeActividad(listado,
                            nListado,
                            datos[i].centro,
                            datos[i].actividad_base) == 0) {

            strcpy(listado[nListado].centro, datos[i].centro);
            strcpy(listado[nListado].actividad, datos[i].actividad_base);
            nListado++;
        }
    }

    printf("\nListado de actividades por centro:\n\n");

    for (i = 0; i < nListado; i++) {
        printf("%s -> %s\n",
               listado[i].centro,
               listado[i].actividad);
    }

    free(listado);
    free(datos);
}

void frecuenciaDiariaActividades() {
    FILE *f;

    Actividad *datos;

    int n = 0;

    char actividadBuscada[100];

    char cabecera[1000];

    int encontrada = 0;

    datos = (Actividad *) malloc(MAX_DATOS * sizeof(Actividad));

    if (datos == NULL) {
        printf("Error de memoria\n");
        return;
    }

    f = fopen("dataset.csv", "r");

    if (f == NULL) {
        printf("No se pudo abrir el fichero\n");
        free(datos);
        return;
    }

    fgets(cabecera, 1000, f);

    printf("Introduce una actividad (en minusculas y con barra baja): ");

    scanf("%s", actividadBuscada);

    printf("\nHORARIOS DISPONIBLES\n\n");

    while (n < MAX_DATOS &&
           fscanf(f,
                  "%d %d %d %s %s %s %s %s %s %d %d %d %s",
                  &datos[n].anio,
                  &datos[n].mes,
                  &datos[n].dia,
                  datos[n].dia_semana,
                  datos[n].hora_inicio,
                  datos[n].hora_fin,
                  datos[n].actividad_base,
                  datos[n].modalidad,
                  datos[n].centro,
                  &datos[n].plazas,
                  &datos[n].ocupadas,
                  &datos[n].libres,
                  datos[n].tipo_actividad) == 13) {

        if (strcmp(datos[n].actividad_base, actividadBuscada) == 0) {

            printf("Centro: %s\n", datos[n].centro);
            printf("Dia: %s\n", datos[n].dia_semana);
            printf("Horario: %s - %s\n",
                   datos[n].hora_inicio,
                   datos[n].hora_fin);
            printf("Plazas libres: %d\n\n", datos[n].libres);

            encontrada = 1;
        }

        n++;
    }

    if (encontrada == 0) {
        printf("No se encontro esa actividad.\n");
    }

    fclose(f);
    free(datos);
}

void actividadMasFrecuentadaPorCentro(FILE *fichero) {
    char centroBuscado[N];
    Actividad a;
    Auxiliar lista[500]; 
    char cabecera[1000];
    int nLista = 0;
    int i, encontrado;
    int maxFrecuencia = 0;
    int indiceGanador = -1;

    printf("Has elegido actividad mas frecuentada por centro.\n");

    do {
        printf("Nombre del centro: ");
        scanf(" %99[^\n]", centroBuscado);
        if (existeCentro(fichero, centroBuscado) == 0) {
            printf("Ese centro no existe. Intentalo de nuevo.\n");
        }
    } while (existeCentro(fichero, centroBuscado) == 0);

    rewind(fichero);
    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a)) {
        if (strcmp(a.centro, centroBuscado) == 0) {
            encontrado = 0;
            
            for (i = 0; i < nLista && encontrado == 0; i++) {
                if (strcmp(lista[i].nombreActividad, a.actividad_base) == 0) {
                    lista[i].contador++;
                    encontrado = 1;
                }
            }
            
            if (encontrado == 0 && nLista < 500) {
                strcpy(lista[nLista].nombreActividad, a.actividad_base);
                lista[nLista].contador = 1;
                nLista++;
            }
        }
    }

    for (i = 0; i < nLista; i++) {
        if (lista[i].contador > maxFrecuencia) {
            maxFrecuencia = lista[i].contador;
            indiceGanador = i;
        }
    }

    if (indiceGanador != -1) {
        printf("\n>> La actividad mas frecuentada en '%s' es: %s\n", 
               centroBuscado, lista[indiceGanador].nombreActividad);
        printf(">> Se oferta %d veces en total.\n", lista[indiceGanador].contador);
    } else {
        printf("\nNo se encontraron datos para este centro.\n");
    }
}


