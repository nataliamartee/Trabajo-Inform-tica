int leerActividad(FILE *fichero, Actividad *a) {
    return fscanf(fichero,
                  "%d %d %d %s %s %s %s %s %s %d %d %d %s",
                  &a->anio,
                  &a->mes,
                  &a->dia,
                  a->dia_semana,
                  a->hora_inicio,
                  a->hora_fin,
                  a->actividad_base,
                  a->modalidad,
                  a->centro,
                  &a->plazas,
                  &a->ocupadas,
                  &a->libres,
                  a->tipo_actividad) == 13;
}

int existeCentro(FILE *fichero, char centroBuscado[]) {
    Actividad a;
    char cabecera[1000];
    int encontrado = 0;

    rewind(fichero);
    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a) && encontrado == 0) {
        if (strcmp(a.centro, centroBuscado) == 0) {
            encontrado = 1;
        }
    }

    return encontrado;
}

int existeActividadEnCentro(FILE *fichero, char centroBuscado[], char actividadBuscada[]) {
