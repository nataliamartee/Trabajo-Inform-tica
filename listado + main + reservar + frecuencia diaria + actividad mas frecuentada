void actividadesCompletasPorCentro(FILE *fichero) {
    char centroBuscado[N];
    Actividad a;
    char cabecera[1000];
    int contador = 0;

    printf("\n--- BUSCADOR DE ACTIVIDADES COMPLETAS ---\n");

    do {
        printf("Introduce el nombre del centro: ");
        scanf(" %99[^\n]", centroBuscado);
        
        if (existeCentro(fichero, centroBuscado) == 0) {
            printf("  -> El centro no existe en el sistema. Intentalo de nuevo.\n");
        }
    } while (existeCentro(fichero, centroBuscado) == 0);

    printf("\nBuscando clases sin plazas en '%s'...\n", centroBuscado);

    rewind(fichero);
    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a)) {
        if (strcmp(a.centro, centroBuscado) == 0) {
            if (a.libres == 0) {
                printf("\nActividad: %s\n", a.actividad_base);
                printf("Dia: %s\n", a.dia_semana);
                printf("Horario: %s - %s\n", a.hora_inicio, a.hora_fin);
                printf("Estado: LLENO (0 plazas libres)\n");
                
                contador++;
            }
        }
    }

    if (contador == 0) {
        printf("\n>> No hay actividades saturadas en '%s'.\n", centroBuscado);
    } else {
        printf("\n>> Se encontraron %d actividades sin plazas en este centro.\n", contador);
    }
}


