//funcion main

int main() {

    FILE *fichero;

    int opcion = 0;

    //Comprueba si el fichero existe y se puede abrir.
    

    fichero = fopen("dataset.csv", "r");

    if (fichero == NULL) {

        printf("No se pudo abrir el fichero\n");

