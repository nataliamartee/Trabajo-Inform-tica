//funcion leerActividad

//Lee una línea del fichero y guarda los datos dentro de una estructura Actividad.



int leerActividad(FILE *fichero, Actividad *a) {

    return fscanf(fichero,
                  "%d %d %d %s %s %s %s %s %s %d %d %d %s",

                  &a->anio,
                  &a->mes,
                  &a->dia,

                  a->dia_semana,

                  a->hora_inicio,
                  a->hora_fin,

                  a->actividad_base,
                  a->modalidad,
                  a->centro,

                  &a->plazas,
                  &a->ocupadas,
                  &a->libres,

                  a->tipo_actividad) == 13;
}



//funcion existeCentro
//Recorre el fichero buscando el centro introducido.

int existeCentro(FILE *fichero, char centroBuscado[]) {

    Actividad a;

    char cabecera[1000];

    int encontrado = 0;

    rewind(fichero);

    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a) && encontrado == 0) {

        if (strcmp(a.centro, centroBuscado) == 0) {

            encontrado = 1;
        }
    }

    return encontrado;
}



//funcion existeActividadEnCentro
//Comprueba si existe una actividad concreta dentro del centro seleccionado

int existeActividadEnCentro(FILE *fichero,
                            char centroBuscado[],
                            char actividadBuscada[]) {

    Actividad a;

    char cabecera[1000];

    int encontrado = 0;

    rewind(fichero);

    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a) && encontrado == 0) {

        if (strcmp(a.centro, centroBuscado) == 0 &&
            strcmp(a.actividad_base, actividadBuscada) == 0) {

            encontrado = 1;
        }
    }

    return encontrado;
}



//funcion existeHorario

//Comprueba si existe un horario concreto para una actividad y un día determinados.


int existeHorario(FILE *fichero,
                   char centroBuscado[],
                   char actividadBuscada[],
                   char diaBuscado[],
                   char horarioBuscado[]) {

    Actividad a;

    char cabecera[1000];

    int encontrado = 0;

    rewind(fichero);

    fgets(cabecera, 1000, fichero);

    while (leerActividad(fichero, &a) && encontrado == 0) {

        if (strcmp(a.centro, centroBuscado) == 0 &&
            strcmp(a.actividad_base, actividadBuscada) == 0 &&
            strcmp(a.dia_semana, diaBuscado) == 0 &&
            strcmp(a.hora_inicio, horarioBuscado) == 0) {

            encontrado = 1;
        }
    }

    return encontrado;
}




//funcion reservarPlaza

//Pide:centro, actividad,dia,horario

//Después comprueba si hay plazas libres.


void reservarPlaza(FILE *fichero) {

    char centroBuscado[N];

    char actividadBuscada[N];

    char diaBuscado[N];

    char horarioBuscado[N];

    Actividad a;

    char cabecera[1000];

    int reservaHecha = 0;


    
    //Pide el centro hasta que exista
    

    do {

        printf("Nombre del centro: ");

        scanf("%s", centroBuscado);

        if (existeCentro(fichero, centroBuscado) == 0) {

            printf("Ese centro no existe. Intentalo otra vez.\n");
        }

    } while (existeCentro(fichero, centroBuscado) == 0);



    //Pide actividad hasta que exista
    

    do {

        printf("Actividad que quieres realizar: ");

        scanf("%s", actividadBuscada);

        if (existeActividadEnCentro(fichero,
                                    centroBuscado,
                                    actividadBuscada) == 0) {

            printf("Esa actividad no existe en ese centro.\n");
        }

    } while (existeActividadEnCentro(fichero,
                                     centroBuscado,
                                     actividadBuscada) == 0);



    //Pide día hasta que exista
    

    do {

        printf("Dia de la semana: ");

        scanf("%s", diaBuscado);

        rewind(fichero);

        fgets(cabecera, 1000, fichero);

        reservaHecha = 0;

        while (leerActividad(fichero, &a) && reservaHecha == 0) {

            if (strcmp(a.centro, centroBuscado) == 0 &&
                strcmp(a.actividad_base, actividadBuscada) == 0 &&
                strcmp(a.dia_semana, diaBuscado) == 0) {

                reservaHecha = 1;
            }
        }

        if (reservaHecha == 0) {

            printf("Ese dia no existe para esa actividad.\n");
        }

    } while (reservaHecha == 0);



    //Pide horario hasta que exista


    do {

        printf("Horario de inicio: ");

        scanf("%s", horarioBuscado);

        if (existeHorario(fichero,
                           centroBuscado,
                           actividadBuscada,
                           diaBuscado,
                           horarioBuscado) == 0) {

            printf("Ese horario no existe.\n");
        }

    } while (existeHorario(fichero,
                            centroBuscado,
                            actividadBuscada,
                            diaBuscado,
                            horarioBuscado) == 0);



    
    //Busca la actividad concreta y comprueba plazas libres
    

    rewind(fichero);

    fgets(cabecera, 1000, fichero);

    reservaHecha = 0;

    while (leerActividad(fichero, &a) && reservaHecha == 0) {

        if (strcmp(a.centro, centroBuscado) == 0 &&
            strcmp(a.actividad_base, actividadBuscada) == 0 &&
            strcmp(a.dia_semana, diaBuscado) == 0 &&
            strcmp(a.hora_inicio, horarioBuscado) == 0) {

            //Si hay plazas libres la reserva es correcta

            if (a.libres > 0) {

                printf("\nPlaza reservada correctamente.\n");

                printf("Centro: %s\n", a.centro);

                printf("Actividad: %s\n", a.actividad_base);

                printf("Dia: %s\n", a.dia_semana);

                printf("Horario: %s\n", a.hora_inicio);

                printf("Plazas libres: %d\n", a.libres);

            } else {

                printf("\nNo hay plazas disponibles.\n");
            }

            reservaHecha = 1;
        }
    }
}



