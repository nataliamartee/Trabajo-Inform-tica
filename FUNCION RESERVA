    }

    fclose(fichero);


    //Menú principal.
    //Se repite hasta elegir la opción 6.

    while (opcion != 6) {

        mostrarMenu();

        scanf("%d", &opcion);


        if (opcion == 1) {

            actividadMasFrecuentadaPorCentro();

        } else if (opcion == 2) {

