void mediaplazasporhora(FILE *fichero) {
    Actividad a;
    char cabecera[1000];

    int suma[24] = {0};
    int cuenta[24] = {0};

    rewind(fichero);
    fgets(cabecera, 1000, fichero);  //salta la cabecera del fichero

    while (leerActividad(fichero, &a)) {

        int hora = 0;

        // hora_inicio formato "8:00"
        sscanf(a.hora_inicio, "%2d", &hora);

        if (hora >= 0 && hora < 24) {
            suma[hora] += a.ocupadas;
            cuenta[hora]++;
        }
    }

    printf("\nMEDIA DE PLAZAS OCUPADAS POR HORA\n");

    for (int h = 0; h < 24; h++) {
        if (cuenta[h] > 0) {
            float media = (float)suma[h] / cuenta[h]; //calcula la media
            printf("%02d:00 - %.2f plazas ocupadas de media en los centros \n", h, media);
        }
    }
}
