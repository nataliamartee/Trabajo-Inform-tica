#include <stdio.h>
#include <stdlib.h>//para usar malloc y free
#include <string.h>//para usar strcmp y strcpy

#define N 100
#define MAX_DATOS 10000

typedef struct {
    int anio;
    int mes;
    int dia;
    char dia_semana[N];
    char hora_inicio[N];
    char hora_fin[N];
    char actividad_base[N];
    char modalidad[N];
    char centro[N];
    int plazas;
    int ocupadas;
    int libres;
    char tipo_actividad[N];
} Actividad;

typedef struct {//Estructura para guardar el listado final
    char centro[N];
    char actividad[N];
} Listado;

void mostrarMenu();

void actividadMasFrecuentadaPorCentro();
void reservarPlaza();
void listadoActividadesPorCentro();
void actividadMayorDisponibilidadPorCentro();
void frecuenciaDiariaActividades();
void graficas();

int main() {//Función principal del programa
    FILE *fichero;//Puntero al fichero

    fichero = fopen("dataset.csv", "r");

    if (fichero == NULL) {//Si no se ha podido abrir el fichero
        printf("No se pudo abrir el fichero\n");
        return 1;
    }

    fclose(fichero);

    int opcion = 0;//Guarda la opción elegida por el usuario

    while (opcion != 6) {
    mostrarMenu();
    scanf("%d", &opcion);

    if (opcion == 1) {
        actividadMasFrecuentadaPorCentro();

    } else if (opcion == 2) {
        reservarPlaza();

    } else if (opcion == 3) {
        listadoActividadesPorCentro();

    } else if (opcion == 4) {
        frecuenciaDiariaActividades();

    } else if (opcion == 5) {
        graficas();

    } else if (opcion == 6) {
        printf("Saliendo del programa...\n");

    } else {
        printf("Opcion no valida.\n");
    }
}

    return 0;
}

