#include <string.h>//para usar strcmp y strcpy

#define N 100
#define MAX_DATOS 10000

typedef struct {
    int anio;
    int mes;
    int dia;
    char dia_semana[N];
    char hora_inicio[N];
    char hora_fin[N];
    char actividad_base[N];
    char modalidad[N];
    char centro[N];
    int plazas;
    int ocupadas;
    int libres;
    char tipo_actividad[N];
} Actividad;

typedef struct {//Estructura para guardar el listado final
    char centro[N];
    char actividad[N];
} Listado;

void mostrarMenu();

void actividadMasFrecuentadaPorCentro();
