#include <stdio.h>   
#include <stdlib.h>  
#include <string.h>  

#define N 100             
#define MAX_DATOS 10000   


typedef struct { 
    int anio;
    int mes; 
    int dia; 
    char dia_semana[N];
    char hora_inicio[N];
    char hora_fin[N];
    char actividad_base[N];
    char modalidad[N];
    char centro[N];
    int plazas; 
    int ocupadas; 
    int libres;
    char tipo_actividad[N]; 
} Actividad;


int leerFichero(Actividad *datos);
int existeCentro(Actividad *v, int n, char centro[]);
void mostrarCentrosSaturados(Actividad *v, int n);


int main() {
    Actividad *datos; 
    int n;            

    // Reserva de memoria
    datos = (Actividad *) malloc(MAX_DATOS * sizeof(Actividad)); 

    if (datos == NULL) { 
        printf("Error de memoria\n");
        return 1;
    }

    // Leemos el fichero dataset.csv
    n = leerFichero(datos); 

    if (n == 0) {
        printf("No se han cargado datos\n");
        free(datos); 
        return 1;
    }

    // Llamamos a la función de centros saturados
    mostrarCentrosSaturados(datos, n);

    // Liberamos memoria antes de salir
    free(datos); 

    return 0; 
}


int leerFichero(Actividad *datos) {
    FILE *f;
    int n = 0;
    char cabecera[300]; 

    f = fopen("dataset.csv", "r"); 

    if (f == NULL) { 
        printf("Error al abrir dataset.csv\n");
        return 0;
    }

    fgets(cabecera, 300, f); 

    while (n < MAX_DATOS &&   
           fscanf(f, "%d %d %d %s %s %s %s %s %s %d %d %d %s",
                  &datos[n].anio, &datos[n].mes, &datos[n].dia,
                  datos[n].dia_semana, datos[n].hora_inicio, datos[n].hora_fin,
                  datos[n].actividad_base, datos[n].modalidad, datos[n].centro,
                  &datos[n].plazas, &datos[n].ocupadas, &datos[n].libres,
                  datos[n].tipo_actividad) == 13) {
        n++;
    }

    fclose(f); 
    return n; 
}


int existeCentro(Actividad *v, int n, char centro[]) {
    int i;
    for (i = 0; i < n; i++) {
        if (strcmp(v[i].centro, centro) == 0) {
            return 1;
        }
    }
    return 0;
}


void mostrarCentrosSaturados(Actividad *v, int n) {
    char centroBuscado[N];
    int i;
    int contador = 0;

    printf("\n--- BUSCADOR DE ACTIVIDADES SATURADAS ---\n");

    // Bucle para pedir el centro hasta que introduzca uno válido
    do {
        printf("\nIntroduce el centro a comprobar: ");
        scanf(" %99[^\n]", centroBuscado);
        
        if (existeCentro(v, n, centroBuscado) == 0) {
            printf("  -> Ese centro no existe en el sistema. Intentalo de nuevo.\n");
        }
    } while (existeCentro(v, n, centroBuscado) == 0);

    printf("\nBuscando clases sin plazas en '%s'...\n", centroBuscado);

    // Bucle para buscar actividades con 0 plazas libres
    for (i = 0; i < n; i++) {
        if (strcmp(v[i].centro, centroBuscado) == 0) {
            
            if (v[i].libres == 0) {
                printf("\nActividad: %s\n", v[i].actividad_base);
                printf("Dia: %s\n", v[i].dia_semana);
                printf("Horario: %s - %s\n", v[i].hora_inicio, v[i].hora_fin);
                printf("Estado: LLENO (0 plazas libres)\n");
                
                contador++;
            }
        }
    }

    // Resumen final
    if (contador == 0) {
        printf("\n>> No hay actividades saturadas en '%s'.\n", centroBuscado);
    } else {
        printf("\n>> Se encontraron %d actividades sin plazas en este centro.\n", contador);
    }
}
