void mostrarCentrosSaturados(void);

int leerActividad(FILE *fichero, Actividad *a);
int existeCentro(FILE *fichero, char centroBuscado[]);

int main() {
    FILE *fichero;
    int opcion = 0;

    fichero = fopen("dataset.csv", "r");
    if (fichero == NULL) {
        printf("No se pudo abrir el fichero dataset.csv\n");
        return 1;
    }
    fclose(fichero);

    while (opcion != 7) {
        mostrarMenu();
        scanf("%d", &opcion);

        if (opcion == 1) {
            fichero = fopen("dataset.csv", "r");
            if (fichero == NULL) {
                printf("No se pudo abrir el fichero\n");
            } else {
                actividadMasFrecuentadaPorCentro(fichero);
                fclose(fichero);
            }

        } else if (opcion == 2) {
            reservarPlaza();

        } else if (opcion == 3) {
            listadoActividadesPorCentro();

        } else if (opcion == 4) {
            frecuenciaDiariaActividades();

        } else if (opcion == 5) {
            actividadMayorDisponibilidadPorCentro();

        } else if (opcion == 6) {
            mostrarCentrosSaturados();

        } else if (opcion == 7) {
            printf("Saliendo del programa...\n");

        } else {
            printf("Opcion no valida.\n");
        }
    }

    return 0;
}

