#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define N 100
#define MAX_DATOS 10000

typedef struct {
    int anio;
    int mes;
    int dia;
    char dia_semana[N];
    char hora_inicio[N];
    char hora_fin[N];
    char actividad_base[N];
    char modalidad[N];
    char centro[N];
    int plazas;
    int ocupadas;
    int libres;
    char tipo_actividad[N];
} Actividad;

void mostrarMenu(void);
void actividadMasFrecuentadaPorCentro(void);
void reservarPlaza(void);
void listadoActividadesPorCentro(void);
void frecuenciaDiariaActividades(FILE *fichero);
void actividadMayorDisponibilidadPorCentro(void);
void graficas(void);

int leerActividad(FILE *fichero, Actividad *a);
int existeCentro(FILE *fichero, char centroBuscado[]);
int existeActividadEnCentro(FILE *fichero, char centroBuscado[], char actividadBuscada[]);
int existeDia(FILE *fichero, char centroBuscado[], char actividadBuscada[], char diaBuscado[]);

int main() {
    FILE *fichero;
    int opcion = 0;

    fichero = fopen("datasett.csv", "r");
    if (fichero == NULL) {
        printf("No se pudo abrir el fichero datasett.csv\n");
        return 1;
    }
    fclose(fichero);

    while (opcion != 6) {
        mostrarMenu();
        scanf("%d", &opcion);

        if (opcion == 1) {
            actividadMasFrecuentadaPorCentro();

        } else if (opcion == 2) {
            reservarPlaza(); 

        } else if (opcion == 3) {
            listadoActividadesPorCentro();

        } else if (opcion == 4) {
            fichero = fopen("datasett.csv", "r");
            if (fichero == NULL) {
                printf("No se pudo abrir el fichero\n");
            } else {
                frecuenciaDiariaActividades(fichero);
                fclose(fichero);
            }

        } else if (opcion == 5) {
            graficas();

        } else if (opcion == 6) {
            printf("Saliendo del programa...\n");

        } else {
            printf("Opcion no valida.\n");
        }
    }

    return 0;
}

