void frecuenciaDiariaActividades(FILE *fichero) {
    char centroBuscado[N];
    char actividadBuscada[N];
    char diaBuscado[N];
    Actividad a;
    char cabecera[1000];
    int frecuencia = 0;

    printf("\n--- FRECUENCIA DIARIA DE ACTIVIDADES ---\n");

    do {
        printf("Nombre del centro: ");
        scanf(" %99[^\n]", centroBuscado); 
        
        if (existeCentro(fichero, centroBuscado) == 0) {
            printf("Ese centro no existe. Intentalo otra vez.\n");
        }
    } while (existeCentro(fichero, centroBuscado) == 0);

    do {
        printf("Actividad que quieres consultar: ");
        scanf(" %99[^\n]", actividadBuscada);
        
        if (existeActividadEnCentro(fichero, centroBuscado, actividadBuscada) == 0) {
            printf("Esa actividad no existe en ese centro. Intentalo otra vez.\n");
        }
    } while (existeActividadEnCentro(fichero, centroBuscado, actividadBuscada) == 0);

    do {
        printf("Dia de la semana (ej. Lunes): ");
        scanf(" %99[^\n]", diaBuscado);
        
        if (existeDia(fichero, centroBuscado, actividadBuscada, diaBuscado) == 0) {
            printf("No se oferta esa actividad ese dia en ese centro. Intentalo otra vez.\n");
        }
    } while (existeDia(fichero, centroBuscado, actividadBuscada, diaBuscado) == 0);

    rewind(fichero);
    fgets(cabecera, 1000, fichero);
    
    while (leerActividad(fichero, &a)) {
        if (strcmp(a.centro, centroBuscado) == 0 &&
            strcmp(a.actividad_base, actividadBuscada) == 0 &&
            strcmp(a.dia_semana, diaBuscado) == 0) {
            
            frecuencia++;
        }
    }

    printf("\n>> RESULTADO: La actividad '%s' se oferta %d veces el %s en '%s'.\n", 
           actividadBuscada, frecuencia, diaBuscado, centroBuscado);
}

