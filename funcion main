int main() {
    FILE *fichero;
    char linea[10000];

    fichero = fopen("dataset.csv", "r");

    if (fichero == NULL) {
        printf("No se pudo abrir el fichero\n");
        return 1;
    }


    fclose(fichero);

    int opcion = 0;

	while (opcion != 6) {
	    mostrarMenu();
	    scanf("%d", &opcion);
	    limpiarEntrada();
	
	    if (opcion == 1) {
	        actividadMasFrecuentadaPorCentro();
	
	    } else if (opcion == 2) {
	        reservarPlaza();
	
	    } else if (opcion == 3) {
	        listadoActividadesPorCentro();
	
	    } else if (opcion == 4) {
	        frecuenciaDiariaActividades(); // nueva opción
	
	    } else if (opcion == 5) {
	        graficas(); // nueva opción
	
	    } else if (opcion == 6) {
	        printf("Saliendo del programa...\n");
	
	    } else {
	        printf("Opcion no valida.\n");
	    }
	}

    return 0;
}

void mostrarMenu(void) {
